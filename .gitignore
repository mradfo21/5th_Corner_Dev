# Turn-thread scratch markers (swept at runtime; see _sweep_thread_signals)
thread_signal_*.tmp

# Autoplay run artifacts
autoplay_report.json
voice_design_cache.json

# Stale Discord-bot PID file (no longer used)
.story_pids.json

# Saved LEVELS (named level-layer snapshots) — runtime user data
levels/*
!levels/.gitkeep
tunables.json
assets/music/*
!assets/music/.gitkeep

# Playtest and render output. Runs write ~1 GB of stills apiece; the videos and
# transcripts are the deliverable and live on disk, not in git.
# Sweep with: python tools/clean_artifacts.py --apply
playtest_results/
test_flipbook_output/

# PyInstaller build output (see tools/build_exe.py)
build/
dist/
*.spec.bak

# Scratch probes and the stdout/stderr they were redirected into. A debugging
# session leaves dozens of these and none of them are ever the deliverable;
# left untracked they bury `git status` and make the real diff unreadable.
# Convention: give a throwaway a leading underscore at the repo root and it
# stays out of git. Anything worth keeping goes in tools/ with a real name.
/_*.py
/_*.txt
/_*.ps1
/_*.bat
/_*.json
/_playthrough/
*.bak

# In-game bug captures (frame + logs + state + prompts). Local evidence for a
# report, regenerated on demand — see /api/bug/capture.
bugs/

# Recorded generations: vision analyses keyed by frame hash, and the image/text
# replay ledger. Reproducible by paying for the run again, so not source — but
# do not delete these casually, they are what makes a replay run free.
.cache/
