__pycache__/
*.pyc
*.pyo
*.pyd
.DS_Store
*.log
node_modules/
config.json
images/
logs/
tapes/
world_state.json
history.json
# Runtime game state - created on demand, not tracked
sessions/*
!sessions/.gitkeep
archives/*
!archives/.gitkeep
# Uploaded character/setting reference plates (Cast & Camera) — runtime user data
assets/references/*
!assets/references/.gitkeep
# The player's characters (characters.py) — runtime user data, like sessions.
# The shipped starter lives in assets/characters/ and IS tracked.
characters/*
!characters/.gitkeep
# Saved "worlds" (named prompt-set snapshots) — this machine's authoring.
# The shipped SOMEWHERE demo is the only World that goes in a build.
worlds/*
!worlds/.gitkeep
!worlds/somewhere.json
!worlds/somewhere-fp.json
!worlds/somewhere.frame.png
!worlds/somewhere.frame.json
# Experience graphs — this machine's authoring, except the shipped demo.
experiences/*
!experiences/.gitkeep
!experiences/somewhere.json
experiences/.active
autotest/*.json
autotest/*.txt
test_sessions/
static/Logo_normalized.jpg
# ai_config.json - MUST be deployed to production!
lore/text/*
!lore/text/00_README.md
!lore/text/EXAMPLE_*
lore/images/*
!lore/images/.gitkeep
*.gif
*.mp4
.env
*.env
render.env
RENDER_SETUP.txt
# Test suites are source, every one of them. This used to be `test_*.py` plus
# an allowlist, and the allowlist silently dropped suites twice (sixteen the
# first time, test_cutscene.py's 50 tests among them; eight more on 2026-09-25,
# test_combat / test_run_tape / test_provider_bridge among them, which CLAUDE.md
# names as the invariants). A scratch probe goes in _claude_* or the scratchpad.

# Turn-thread scratch markers (swept at runtime; see _sweep_thread_signals)
thread_signal_*.tmp

# Autoplay run artifacts
autoplay_report.json
voice_design_cache.json

# Stale Discord-bot PID file (no longer used)
.story_pids.json

# Saved LEVELS (named level-layer snapshots) — runtime user data
levels/*
!levels/.gitkeep
tunables.json
assets/music/*
!assets/music/.gitkeep

# Playtest and render output. Runs write ~1 GB of stills apiece; the videos and
# transcripts are the deliverable and live on disk, not in git.
# Sweep with: python tools/clean_artifacts.py --apply
playtest_results/
test_flipbook_output/

# PyInstaller build output (see tools/build_exe.py)
build/
dist/
*.spec.bak

# Scratch probes and the stdout/stderr they were redirected into. A debugging
# session leaves dozens of these and none of them are ever the deliverable;
# left untracked they bury `git status` and make the real diff unreadable.
# Convention: give a throwaway a leading underscore at the repo root and it
# stays out of git. Anything worth keeping goes in tools/ with a real name.
/_*.py
/_*.txt
/_*.ps1
/_*.bat
/_*.json
/_playthrough/
*.bak

# In-game bug captures (frame + logs + state + prompts). Local evidence for a
# report, regenerated on demand — see /api/bug/capture.
bugs/

# Recorded generations: vision analyses keyed by frame hash, and the image/text
# replay ledger. Reproducible by paying for the run again, so not source — but
# do not delete these casually, they are what makes a replay run free.
.cache/

# /get shows short recordings of the game (tools/cut_clips.py), ~100 MB a shoot
# and re-shot whenever the game changes. That is not something to put in git
# history over and over: the posters and clips.json are tracked, the mp4s are
# published beside the builds (Distribution MVP, M5), not committed.

# Agent-session scratch and screenshot evidence (CLAUDE.md, section 3). Never
# source; kept out of `git status` so real changes are visible.
_claude_*
_claude_*/
_menushots_*/
_playthrough/
/_*.png
/the
thread_signal_*.tmp
_pt_out.txt
_pt_err.txt
# Local launchers for the retired agent command runner (_claude_runner.py).
START_CLAUDE*.bat
MERGE_AND_RUN.bat
